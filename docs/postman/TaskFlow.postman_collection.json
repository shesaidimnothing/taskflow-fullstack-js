    {
      "name": "2 - Créer le compte A et récupérer son jeton",
      "item": [
        {
          "name": "A - Créer un compte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Première exécution : crée A avec un email de test. Le jeton est enregistré dans la variable de collection tokenA. En cas de 409 lors d’une nouvelle exécution, utiliser la requête de connexion."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('emailA')) { pm.collectionVariables.set('emailA', `demo-a-${Date.now()}@example.test`); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"A - Créer un compte répond HTTP 201\", function () { pm.response.to.have.status(201); });const data = pm.response.json(); pm.collectionVariables.set('tokenA', data.token); pm.collectionVariables.set('emailA', data.user.email); pm.collectionVariables.set('userIdA', data.user.id); pm.test('Le mot de passe n’est pas renvoyé', function () { pm.expect(data.user.password).to.be.undefined; pm.expect(data.user.passwordHash).to.be.undefined; });"
                ]
              }
            }
          ]
        },
        {
          "name": "A - Email déjà utilisé (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Après l’inscription A, réutiliser le même email. Le serveur refuse la deuxième inscription."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Adresse email déjà utilisée répond 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Code EMAIL_ALREADY_USED', function () { pm.expect(pm.response.json().error.code).to.eql('EMAIL_ALREADY_USED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "A - Se connecter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Récupère un nouveau tokenA après la création de A. Exécuter après A - Créer un compte ou plus tard pour renouveler le jeton."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"A - Se connecter répond HTTP 200\", function () { pm.response.to.have.status(200); });const data = pm.response.json(); pm.collectionVariables.set('tokenA', data.token); pm.collectionVariables.set('userIdA', data.user.id);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Choisir une adresse email fictive. Le jeton sert aux tâches du compte A et expire après une heure."
